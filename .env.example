# Backend local isolado usado pelo Admin e pela Vitrine
NEXT_PUBLIC_RUST_URL=http://localhost:8080
STORE_ID=1043
APP_ENV=local

# Login local do Admin (defina valores somente em .env.local)
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Meta / WhatsApp Cloud API
# App ID e Configuration ID sao publicos e entram no bundle do navegador.
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v24.0

# Nunca use NEXT_PUBLIC_ para os valores abaixo.
FACEBOOK_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_REGISTRATION_PIN=
META_GRAPH_VERSION=v24.0

# Token de plataforma para bootstrap/diagnostico. O fluxo multi-loja definitivo
# deve usar o token obtido no Embedded Signup, criptografado e isolado por loja.
FACEBOOK_SYSTEM_USER_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# URL publica usada em callbacks e configuracao do webhook no Meta Developers.
APP_BASE_URL=http://localhost:3000

# Segredo do webhook de eventos do e-commerce. O emissor pode assinar o corpo
# com HMAC SHA-256 em x-upzero-signature ou enviar este valor como token.
UPZERO_WEBHOOK_SECRET=
CRON_SECRET=

# Postgres transacional usado para persistir o estado de mensageria por loja.
# Nunca exponha a string de conexao como NEXT_PUBLIC_.
DATABASE_URL=

# Criptografa, por loja, as chaves OpenAI cadastradas pelos clientes no Admin.
# Gere uma chave aleatoria forte (minimo 24 caracteres) e nunca use NEXT_PUBLIC_.
# Nao altere esta chave depois que clientes salvarem credenciais, pois isso
# impediria a leitura das credenciais ja criptografadas.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Fonte opcional de revendedores reais em modo seguro
# O conector executa somente GET, exige HTTPS e nunca persiste o payload bruto.
SAFE_RESELLER_MODE=sandbox
SAFE_RESELLER_API_URL=
SAFE_RESELLER_API_STORE_ID=
SAFE_RESELLER_API_AUTH=x-api-key
SAFE_RESELLER_API_KEY=

# Estúdio IA — chave somente no servidor. Em produção, usar volume persistente.
OPENAI_API_KEY=
AI_STUDIO_ANALYSIS_MODEL=gpt-6-astra
# AI_STUDIO_DATA_DIR=/var/lib/upzero/ai-studio
AI_STUDIO_DAILY_IMAGES=24
AI_STUDIO_DAILY_ANALYSES=40

# Assinaturas UP Zero — apenas servidor, nunca NEXT_PUBLIC.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# 32 bytes aleatórios em hexadecimal (64 caracteres); mantenha estável para ler tokens salvos.
BILLING_TOKEN_ENCRYPTION_KEY=
# Segredo próprio do webhook, diferente da chave de API.
ASAAS_WEBHOOK_TOKEN=
# Fora da Vercel: somente true se o proxy remover/recriar X-Forwarded-For.
BILLING_TRUST_PROXY=false
